{% extends 'base.twig' %}

{% block title %}Home{% endblock %}

{% block content %}
    {% include 'components/title.twig' %}
    {% if notFound %}
        <div class="error box">
                Error: cannot find the requested blog post
        </div>
    {% endif %}

    <div>
        {% for post in posts %}
            <div class="post-synopsis">
                    <h2>
                        {{ post.title }}
                    </h2>
                    <div class="meta">
                        {{ post.created_at | convertSqlDate }}
                        ({{ post.comment_count }} comments)
                    </div>
                    <p>
                        {{ post.body }}
                    </p>
                    <div class="post-controls">
                        <a 
                            href="view-post?post_id={{ post.id }}"
                        >Read More...</a>
                        {% if isLoggedIn %}
                            |
                            <a
                                href="edit-post?post_id={{ post.id }}" 
                            >Edit</a>
                        {% endif %}
                    </div>
                </div>
        {% endfor %}
    </div>
{% endblock %}