<hr />
<?php if ($errors): ?>
{% if errors %}
    <div class="error box comment-margin">
        <ul>
            {% for error in errors %}
                <li>{{error}}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
<h3>Add your comment</h3>
<form 
    action="view-post?action=add-comment&amp;post_id={{postId}}"
    method="post" 
    class="comment-form user-form"
>
    <div>
        <label for="comment-text">
            Comment:
        </label>
        <textarea
            id="comment-text"
            name="comment-text"
            rows="8"
            cols="70"
            maxlength="300"
        >{{ comment.text }}</textarea>
    </div>
    <div>
        <input type="submit" value="Submit comment" />
    </div>
</form>